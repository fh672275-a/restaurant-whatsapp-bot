# Restaurant WhatsApp Bot - Environment Variables

# Server
PORT=3000
NODE_ENV=production

# Session secret (change this in production!)
SESSION_SECRET=your-super-secret-key-change-this

# Database (SQLite by default - for cloud deployment use PostgreSQL URL)
# DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=

# Super Admin credentials (set on first run)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123

# Bot settings
BOT_ORDER_SESSION_TIMEOUT=30
BOT_AUTO_GREET=true
