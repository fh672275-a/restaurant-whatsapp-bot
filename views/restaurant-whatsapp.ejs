<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp Connect - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
  <style>
    .qr-container {
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }
    .qr-box {
      background: white;
      border: 3px solid #25D366;
      border-radius: 20px;
      padding: 30px;
      margin: 20px 0;
      display: inline-block;
      box-shadow: 0 10px 40px rgba(37,211,102,0.2);
    }
    .qr-box img {
      width: 280px;
      height: 280px;
      display: block;
      margin: 0 auto;
    }
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 14px;
    }
    .status-disconnected { background: #ffeef0; color: #c81e2c; }
    .status-connecting { background: #fff8e1; color: #f57c00; }
    .status-qr_ready { background: #e3f2fd; color: #1976d2; }
    .status-connected { background: #e8f5e9; color: #2e7d32; }
    .pulse {
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    .step-card {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 10px;
      text-align: left;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .step-number {
      background: #25D366;
      color: white;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      flex-shrink: 0;
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
                        <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/bulk-upload"><i class="fas fa-upload"></i> Bulk Upload</a>
        <a href="/restaurant/deals"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/marketing"><i class="fas fa-bullhorn"></i> Marketing</a>
        <a href="/restaurant/pricing"><i class="fas fa-credit-card"></i> Plans & Billing</a>
        <a href="/restaurant/hours"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/delivery"><i class="fas fa-truck"></i> Delivery Areas</a>
        <a href="/restaurant/customers"><i class="fas fa-users"></i> Customers</a>
        <a href="/restaurant/feedback"><i class="fas fa-star"></i> Feedback</a>
        <a href="/restaurant/broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a>
        <a href="/restaurant/reservations"><i class="fas fa-calendar-check"></i> Reservations</a>
        <a href="/restaurant/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/restaurant/whatsapp" class="active"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fab fa-whatsapp"></i> WhatsApp Connect</h1>
      </header>

      <div class="content-body">
        <div class="qr-container">
          <!-- Status Badge -->
          <div id="status-badge" class="status-indicator status-disconnected">
            <i class="fas fa-circle"></i> Loading...
          </div>

          <!-- Connected View -->
          <div id="connected-view" style="display:none;">
            <div class="card mt-4">
              <div class="card-body text-center">
                <div style="font-size: 64px; color: #25D366; margin: 20px 0;">
                  <i class="fab fa-whatsapp"></i>
                </div>
                <h2>WhatsApp Connected! 🎉</h2>
                <p class="text-muted">Aap ka restaurant ab WhatsApp par orders receive kar raha hai</p>
                <div class="mt-3">
                  <strong>Connected Number:</strong>
                  <div id="connected-phone" style="font-size: 24px; color: #075E54;"></div>
                </div>
                <div class="alert alert-info mt-4 text-left">
                  <strong>💡 Test kaise karein:</strong>
                  <ol class="mt-2 mb-0">
                    <li>Kisi doosre number se apne connected WhatsApp number par message bhejein</li>
                    <li>"menu" likh kar bhejein - bot menu bhej dega</li>
                    <li>"order" likh kar order place karein</li>
                    <li>Yahan <a href="/restaurant/orders" class="alert-link">Orders page</a> par naya order aa jayega</li>
                  </ol>
                </div>
                <button onclick="disconnectWhatsApp()" class="btn btn-danger mt-3">
                  <i class="fas fa-power-off"></i> Disconnect WhatsApp
                </button>
              </div>
            </div>
          </div>

          <!-- Disconnected View -->
          <div id="disconnected-view">
            <div class="mt-4">
              <h3>WhatsApp ko apne Restaurant k sath connect karein</h3>
              <p class="text-muted">Ek baar QR scan karein, phir hamesha k liye connected!</p>
            </div>

            <!-- Steps -->
            <div class="mt-3">
              <div class="step-card">
                <div class="step-number">1</div>
                <div>
                  <strong>"Connect WhatsApp" button</strong> dabayein niche
                </div>
              </div>
              <div class="step-card">
                <div class="step-number">2</div>
                <div>
                  <strong>QR code</strong> zahir hoga - isay scan karein
                </div>
              </div>
              <div class="step-card">
                <div class="step-number">3</div>
                <div>
                  Apne phone par <strong>WhatsApp open karein</strong> → Settings → Linked Devices → Link a Device → QR scan karein
                </div>
              </div>
              <div class="step-card">
                <div class="step-number">4</div>
                <div>
                  Connection successful! Ab customers is number par message kar k order de sakte hain
                </div>
              </div>
            </div>

            <!-- QR Display Area -->
            <div id="qr-area" class="mt-4" style="display:none;">
              <div class="qr-box">
                <img id="qr-image" src="" alt="QR Code" />
                <div class="mt-3 text-muted">
                  <i class="fas fa-spinner fa-spin pulse"></i> QR code ka intezar karein...
                </div>
                <div class="mt-2 text-muted small">
                  QR expires in 60 seconds. <a href="#" onclick="generateQR(); return false;">Refresh</a>
                </div>
              </div>
            </div>

            <!-- Connect Button -->
            <button id="connect-btn" onclick="generateQR()" class="btn btn-success btn-lg mt-3">
              <i class="fab fa-whatsapp"></i> Connect WhatsApp
            </button>
          </div>

          <!-- Alert -->
          <div id="alert-msg" class="alert mt-3" style="display:none;"></div>
        </div>
      </div>
    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const RESTAURANT_ID = '<%= user.id %>';

    // Listen for QR code
    socket.on(`whatsapp:qr:${RESTAURANT_ID}`, (data) => {
      document.getElementById('qr-image').src = data.qrDataUrl;
      document.getElementById('qr-area').style.display = 'block';
      updateStatus('qr_ready', 'QR Ready - Scan karein!');
    });

    // Listen for connection
    socket.on(`whatsapp:connected:${RESTAURANT_ID}`, (data) => {
      showConnected(data.phone);
    });

    // Listen for disconnection
    socket.on(`whatsapp:disconnected:${RESTAURANT_ID}`, (data) => {
      showDisconnected();
    });

    function updateStatus(status, message) {
      const badge = document.getElementById('status-badge');
      badge.className = `status-indicator status-${status}`;
      const icons = {
        'disconnected': 'fa-times-circle',
        'connecting': 'fa-spinner fa-spin',
        'qr_ready': 'fa-qrcode',
        'connected': 'fa-check-circle'
      };
      badge.innerHTML = `<i class="fas ${icons[status] || 'fa-circle'}"></i> ${message}`;
    }

    function showConnected(phone) {
      updateStatus('connected', 'Connected!');
      document.getElementById('connected-view').style.display = 'block';
      document.getElementById('disconnected-view').style.display = 'none';
      document.getElementById('connected-phone').textContent = formatPhone(phone);
    }

    function showDisconnected() {
      updateStatus('disconnected', 'Not Connected');
      document.getElementById('connected-view').style.display = 'none';
      document.getElementById('disconnected-view').style.display = 'block';
      document.getElementById('qr-area').style.display = 'none';
    }

    function formatPhone(phone) {
      if (!phone) return '';
      const p = phone.replace(/[^0-9]/g, '');
      if (p.startsWith('92')) {
        return '+92 ' + p.substring(2);
      }
      return phone;
    }

    async function checkStatus() {
      try {
        const res = await fetch('/api/whatsapp/status');
        const data = await res.json();
        if (data.status === 'connected' && data.phone) {
          showConnected(data.phone);
        } else {
          showDisconnected();
        }
      } catch (e) {
        console.error(e);
      }
    }

    async function generateQR() {
      document.getElementById('connect-btn').disabled = true;
      document.getElementById('connect-btn').innerHTML = '<i class="fas fa-spinner fa-spin"></i> Connecting...';
      updateStatus('connecting', 'Connecting...');
      
      try {
        const res = await fetch('/api/whatsapp/connect', { method: 'POST' });
        const data = await res.json();
        if (data.status === 'connected') {
          showConnected(data.phone);
        } else if (data.status === 'connecting') {
          // Wait for QR via socket
          // Hide the connect button, show waiting area
          document.getElementById('connect-btn').style.display = 'none';
          document.getElementById('qr-area').style.display = 'block';
          updateStatus('connecting', 'QR generate ho raha hai...');
        } else if (data.error) {
          showAlert(data.error, 'danger');
          document.getElementById('connect-btn').disabled = false;
          document.getElementById('connect-btn').innerHTML = '<i class="fab fa-whatsapp"></i> Connect WhatsApp';
        }
      } catch (e) {
        showAlert('Connection failed. Try again.', 'danger');
        document.getElementById('connect-btn').disabled = false;
        document.getElementById('connect-btn').innerHTML = '<i class="fab fa-whatsapp"></i> Connect WhatsApp';
      }
    }

    async function disconnectWhatsApp() {
      if (!confirm('WhatsApp disconnect karein? Customers phir messages nahi bhej payenge.')) return;
      try {
        await fetch('/api/whatsapp/disconnect', { method: 'POST' });
        showDisconnected();
        document.getElementById('connect-btn').style.display = 'inline-block';
        document.getElementById('connect-btn').disabled = false;
        document.getElementById('connect-btn').innerHTML = '<i class="fab fa-whatsapp"></i> Connect WhatsApp';
      } catch (e) {
        showAlert('Disconnect failed', 'danger');
      }
    }

    function showAlert(msg, type = 'info') {
      const alert = document.getElementById('alert-msg');
      alert.className = `alert alert-${type}`;
      alert.textContent = msg;
      alert.style.display = 'block';
      setTimeout(() => alert.style.display = 'none', 5000);
    }

    // Initial check
    checkStatus();
  </script>
</body>
</html>
