<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing Plans - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
  <style>
    .plan-card {
      background: white;
      border-radius: 15px;
      padding: 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      transition: all 0.3s;
      position: relative;
      border: 2px solid #e0e0e0;
      height: 100%;
    }
    .plan-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }
    .plan-card.popular {
      border-color: #25D366;
      transform: scale(1.03);
    }
    .plan-card.popular::before {
      content: '⭐ Most Popular';
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: #25D366;
      color: white;
      padding: 4px 16px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .plan-price {
      font-size: 36px;
      font-weight: 700;
      color: #075E54;
      margin: 15px 0;
    }
    .plan-price small {
      font-size: 14px;
      font-weight: 400;
      color: #999;
    }
    .trial-badge {
      background: #e8f5e9;
      color: #2e7d32;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 15px;
    }
    .feature-list {
      list-style: none;
      padding: 0;
      margin: 20px 0;
    }
    .feature-list li {
      padding: 6px 0;
      color: #555;
      font-size: 14px;
    }
    .feature-list li i {
      color: #25D366;
      margin-right: 8px;
    }
    .feature-list li.disabled {
      color: #ccc;
      text-decoration: line-through;
    }
    .feature-list li.disabled i {
      color: #ccc;
    }
    .btn-plan {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 15px;
      border: none;
      transition: all 0.2s;
    }
    .btn-plan:hover { transform: translateY(-1px); }
    .btn-trial { background: #25D366; color: white; }
    .btn-buy { background: #075E54; color: white; }
    .btn-buy:hover { background: #128C7E; color: white; }
    .payment-info {
      background: #f0fff4;
      border: 2px solid #25D366;
      border-radius: 12px;
      padding: 20px;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
      <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/bulk-upload"><i class="fas fa-upload"></i> Bulk Upload</a>
        <a href="/restaurant/deals"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/marketing"><i class="fas fa-bullhorn"></i> Marketing</a>
        <a href="/restaurant/pricing" class="active"><i class="fas fa-credit-card"></i> Plans & Billing</a>
        <a href="/restaurant/hours"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fas fa-credit-card"></i> Plans & Pricing</h1>
      </header>

      <div class="content-body">
        <!-- Current Subscription -->
        <div id="current-sub" class="alert" style="display:none;"></div>

        <!-- Free Trial Banner -->
        <div class="payment-info text-center mb-4">
          <h4><i class="fas fa-gift text-success"></i> 3 Din Ka Free Trial! 🎉</h4>
          <p class="mb-0">Koi bhi plan select karein, 3 din bilkul FREE use karein. Bina payment ke!</p>
        </div>

        <!-- Plans Grid -->
        <div class="row" id="plans-container">
          <div class="text-center py-5 text-muted">Loading plans...</div>
        </div>

        <!-- Payment Info -->
        <div class="payment-info">
          <h4><i class="fas fa-wallet text-success"></i> Payment Method</h4>
          <hr>
          <div class="row">
            <div class="col-md-6">
              <h5>📱 EasyPaisa</h5>
              <p><strong>Number:</strong> 03494117212</p>
              <p><strong>Name:</strong> Muhammad Ashraf</p>
            </div>
            <div class="col-md-6">
              <h5>📱 JazzCash</h5>
              <p><strong>Number:</strong> 03494117212</p>
              <p><strong>Name:</strong> Muhammad Ashraf</p>
            </div>
          </div>
          <hr>
          <p class="mb-0"><i class="fas fa-info-circle text-info"></i> <strong>Process:</strong> Payment karein → Screenshot upload karein → Admin verify karega → Plan activate!</p>
        </div>
      </div>
    </main>
  </div>

  <!-- Payment Modal -->
  <div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Payment Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="payment-modal-body">
          Loading...
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let selectedPlan = null;
    const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));

    async function loadPlans() {
      try {
        const res = await fetch('/api/payments/plans');
        const data = await res.json();
        
        // Load restaurant name
        const restRes = await fetch('/api/auth/me');
        const restData = await restRes.json();
        if (restData.user) {
          document.getElementById('rest-name').textContent = restData.user.name;
        }
        
        // Load current subscription
        try {
          const subRes = await fetch('/api/payments/subscription');
          const subData = await subRes.json();
          if (subData.subscription) {
            const sub = subData.subscription;
            const validUntil = new Date(sub.valid_until).toLocaleDateString();
            const subDiv = document.getElementById('current-sub');
            subDiv.className = 'alert alert-success';
            subDiv.innerHTML = `<i class="fas fa-check-circle"></i> <strong>Active Plan:</strong> ${sub.plan_id} | Valid until: ${validUntil} | ${sub.trial ? '(Free Trial)' : '(Paid)'}`;
            subDiv.style.display = 'block';
          }
        } catch (e) {}
        
        const plans = data.plans || [];
        const container = document.getElementById('plans-container');
        
        if (plans.length === 0) {
          container.innerHTML = '<div class="col-12 text-center py-4 text-muted">No plans available</div>';
          return;
        }
        
        container.innerHTML = plans.map(plan => `
          <div class="col-md-6 col-lg-3 mb-4">
            <div class="plan-card ${plan.popular ? 'popular' : ''}">
              <h4 class="text-center">${plan.name}</h4>
              <div class="text-center">
                <span class="trial-badge"><i class="fas fa-gift"></i> 3 Days Free Trial</span>
              </div>
              <div class="plan-price text-center">
                Rs. ${plan.price.toLocaleString()}
                <small>/month</small>
              </div>
              <ul class="feature-list">
                ${plan.features.maxRestaurants === -1 ? '<li><i class="fas fa-check"></i> Unlimited restaurants</li>' : `<li><i class="fas fa-check"></i> ${plan.features.maxRestaurants} restaurant${plan.features.maxRestaurants > 1 ? 's' : ''}</li>`}
                ${plan.features.maxMenuItems === -1 ? '<li><i class="fas fa-check"></i> Unlimited menu items</li>' : '<li><i class="fas fa-check"></i> Unlimited menu items</li>'}
                ${plan.features.whatsappBot ? '<li><i class="fas fa-check"></i> WhatsApp bot (24/7)</li>' : '<li class="disabled"><i class="fas fa-times"></i> WhatsApp bot</li>'}
                ${plan.features.bulkMenuUpload ? '<li><i class="fas fa-check"></i> Bulk menu upload</li>' : '<li class="disabled"><i class="fas fa-times"></i> Bulk upload</li>'}
                ${plan.features.aiMarketing ? '<li><i class="fas fa-check"></i> AI marketing</li>' : '<li class="disabled"><i class="fas fa-times"></i> AI marketing</li>'}
                ${plan.features.reservations ? '<li><i class="fas fa-check"></i> Reservations</li>' : '<li class="disabled"><i class="fas fa-times"></i> Reservations</li>'}
                ${plan.features.feedback ? '<li><i class="fas fa-check"></i> Feedback system</li>' : '<li class="disabled"><i class="fas fa-times"></i> Feedback</li>'}
                ${plan.features.broadcastMessages ? '<li><i class="fas fa-check"></i> Broadcast messages</li>' : '<li class="disabled"><i class="fas fa-times"></i> Broadcasts</li>'}
                ${plan.features.multiBranch ? '<li><i class="fas fa-check"></i> Multi-branch support</li>' : '<li class="disabled"><i class="fas fa-times"></i> Multi-branch</li>'}
                ${plan.features.prioritySupport ? '<li><i class="fas fa-check"></i> Priority support</li>' : ''}
              </ul>
              <button onclick="startTrial('${plan.id}')" class="btn-plan btn-trial mb-2">
                <i class="fas fa-gift"></i> Start 3-Day Free Trial
              </button>
              <button onclick="buyPlan('${plan.id}')" class="btn-plan btn-buy">
                <i class="fas fa-shopping-cart"></i> Buy Now (Rs. ${plan.price.toLocaleString()})
              </button>
            </div>
          </div>
        `).join('');
      } catch (e) {
        document.getElementById('plans-container').innerHTML = '<div class="col-12 text-center text-danger">Error loading plans</div>';
      }
    }

    async function startTrial(planId) {
      if (!confirm('3 din ka free trial start karein?')) return;
      try {
        const res = await fetch('/api/payments/trial', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          location.reload();
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Error starting trial');
      }
    }

    async function buyPlan(planId) {
      selectedPlan = planId;
      
      const methods = `
        <div class="text-center mb-3">
          <h5>Payment Method Select Karein</h5>
        </div>
        <div class="row">
          <div class="col-6">
            <button onclick="createPayment('easypaisa')" class="btn btn-success w-100 py-3">
              <i class="fas fa-wallet"></i><br>EasyPaisa
            </button>
          </div>
          <div class="col-6">
            <button onclick="createPayment('jazzcash')" class="btn btn-primary w-100 py-3">
              <i class="fas fa-mobile-alt"></i><br>JazzCash
            </button>
          </div>
        </div>
      `;
      
      document.getElementById('payment-modal-body').innerHTML = methods;
      paymentModal.show();
    }

    async function createPayment(method) {
      try {
        const res = await fetch('/api/payments/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId: selectedPlan, paymentMethod: method })
        });
        const data = await res.json();
        
        if (data.success) {
          const body = `
            <div class="text-center">
              <h5 class="text-success"><i class="fas fa-check-circle"></i> Payment Request Created!</h5>
              <hr>
              <p><strong>Amount:</strong> Rs. ${data.amount}</p>
              <p><strong>Method:</strong> ${data.paymentMethod}</p>
              <hr>
              <div class="alert alert-info text-start">
                <h6><i class="fas fa-mobile-alt"></i> ${data.paymentMethod} Details:</h6>
                <p class="mb-1"><strong>Number:</strong> ${data.accountNumber}</p>
                <p class="mb-1"><strong>Name:</strong> ${data.accountName}</p>
              </div>
              <div class="alert alert-warning text-start">
                <h6><i class="fas fa-info-circle"></i> Instructions:</h6>
                <ol class="text-start mb-0">
                  <li>${data.paymentMethod} app open karein</li>
                  <li>Rs. ${data.amount} bhejein: ${data.accountNumber}</li>
                  <li>Payment ka screenshot lein</li>
                  <li>Niche se screenshot upload karein</li>
                </ol>
              </div>
              <input type="hidden" id="payment-id" value="${data.paymentId}">
              <div class="mt-3">
                <label class="form-label"><strong>Screenshot Upload Karein:</strong></label>
                <input type="file" id="screenshot-file" class="form-control" accept="image/*">
              </div>
              <button onclick="uploadScreenshot()" class="btn btn-success w-100 mt-3">
                <i class="fas fa-upload"></i> Screenshot Upload Karein
              </button>
              <p class="text-muted small mt-2">Admin verify karne k baad plan activate ho jayega (24 hours)</p>
            </div>
          `;
          document.getElementById('payment-modal-body').innerHTML = body;
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Error creating payment');
      }
    }

    async function uploadScreenshot() {
      const fileInput = document.getElementById('screenshot-file');
      if (!fileInput.files.length) {
        alert('Pehle screenshot select karein');
        return;
      }
      
      const paymentId = document.getElementById('payment-id').value;
      const formData = new FormData();
      formData.append('screenshot', fileInput.files[0]);
      formData.append('paymentId', paymentId);
      
      try {
        const res = await fetch('/api/payments/screenshot', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        
        if (data.success) {
          alert(data.message);
          paymentModal.hide();
          location.reload();
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Upload failed');
      }
    }

    loadPlans();
  </script>
</body>
</html>
