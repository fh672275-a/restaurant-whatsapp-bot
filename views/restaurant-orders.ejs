<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2>Restaurant</h2><p>Owner Panel</p></div>
      </div>
      <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders" class="active"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp Connect</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1>Orders</h1>
        <div>
          <button onclick="loadOrders()" class="btn btn-sm btn-primary">
            <i class="fas fa-sync"></i> Refresh
          </button>
        </div>
      </header>

      <div class="content-body">
        <!-- Filters -->
        <div class="card mb-3">
          <div class="card-body">
            <div class="row align-items-end">
              <div class="col-md-3">
                <label class="form-label">Status Filter</label>
                <select class="form-control" id="status-filter" onchange="loadOrders()">
                  <option value="all">All Orders</option>
                  <option value="active" selected>Active Orders</option>
                  <option value="new">New</option>
                  <option value="confirmed">Confirmed</option>
                  <option value="preparing">Preparing</option>
                  <option value="ready">Ready</option>
                  <option value="delivered">Delivered</option>
                  <option value="cancelled">Cancelled</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" id="search" placeholder="Phone, name, order ID...">
              </div>
              <div class="col-md-6 text-end">
                <span id="orders-count" class="text-muted">0 orders</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="card">
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="orders-list">
                  <tr><td colspan="8" class="text-center">Loading...</td></tr>
                </tbody>
              </table>
            </div>
            <div id="pagination" class="d-flex justify-content-between mt-3"></div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Order Details Modal -->
  <div class="modal fade" id="orderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Order Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="order-details">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const RESTAURANT_ID = '<%= user.id %>';
    const orderModal = new bootstrap.Modal(document.getElementById('orderModal'));
    let currentPage = 1;
    let currentSearch = '';

    // Real-time new orders
    socket.on(`restaurant:new_order:${RESTAURANT_ID}`, (data) => {
      showNotification(data);
      loadOrders();
    });

    function showNotification(data) {
      if (Notification.permission === 'granted') {
        new Notification('Naya Order!', {
          body: `${data.customer_name || data.customer_phone}\nRs. ${data.total} - ${data.items.length} items`
        });
      }
      // Show toast
      const toast = document.createElement('div');
      toast.className = 'toast show position-fixed';
      toast.style.cssText = 'top:20px; right:20px; z-index:9999; min-width:300px;';
      toast.innerHTML = `
        <div class="toast-header bg-success text-white">
          <strong class="me-auto"><i class="fas fa-bell"></i> Naya Order!</strong>
          <button type="button" class="btn-close btn-close-white" onclick="this.parentElement.parentElement.remove()"></button>
        </div>
        <div class="toast-body">
          <strong>${data.customer_name || data.customer_phone}</strong><br>
          Rs. ${data.total} - ${data.items.length} items
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 10000);
    }

    async function loadOrders(page = 1) {
      currentPage = page;
      const status = document.getElementById('status-filter').value;
      const params = new URLSearchParams({ page, limit: 25 });
      if (status !== 'all') params.set('status', status);
      if (currentSearch) params.set('search', currentSearch);

      try {
        const res = await fetch(`/api/orders?${params}`);
        const data = await res.json();
        const tbody = document.getElementById('orders-list');
        
        if (!data.orders || data.orders.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">Koi order nahi mila</td></tr>';
          document.getElementById('orders-count').textContent = '0 orders';
          document.getElementById('pagination').innerHTML = '';
          return;
        }

        document.getElementById('orders-count').textContent = `${data.pagination.total} orders`;

        const statusColors = {
          'new': 'info', 'confirmed': 'primary', 'preparing': 'warning',
          'ready': 'success', 'delivered': 'secondary', 'cancelled': 'danger'
        };

        tbody.innerHTML = data.orders.map(o => `
          <tr>
            <td><code>${o.id.substring(0, 8)}</code></td>
            <td>
              <strong>${o.customer_name || 'Unknown'}</strong><br>
              <small class="text-muted">${o.customer_phone}</small>
            </td>
            <td>${o.items.length} items<br><small class="text-muted">${o.items.map(i => i.qty + 'x ' + i.name).join(', ').substring(0, 50)}${o.items.length > 0 ? '...' : ''}</small></td>
            <td><strong>Rs. ${o.total}</strong></td>
            <td><span class="badge bg-light text-dark">${o.order_type}</span></td>
            <td><span class="badge bg-${statusColors[o.status]}">${o.status.toUpperCase()}</span></td>
            <td><small>${formatTime(o.created_at)}</small></td>
            <td>
              <button onclick="viewOrder('${o.id}')" class="btn btn-sm btn-outline-primary" title="View">
                <i class="fas fa-eye"></i>
              </button>
              <button onclick="showStatusUpdate('${o.id}', '${o.status}')" class="btn btn-sm btn-outline-warning" title="Update Status">
                <i class="fas fa-edit"></i>
              </button>
            </td>
          </tr>
        `).join('');

        // Pagination
        const pagination = data.pagination;
        const pag = document.getElementById('pagination');
        pag.innerHTML = `
          <div>Showing ${(pagination.page-1)*pagination.limit + 1}-${Math.min(pagination.page*pagination.limit, pagination.total)} of ${pagination.total}</div>
          <div>
            ${pagination.pages > 1 ? `
              <button class="btn btn-sm btn-outline-primary" ${pagination.page === 1 ? 'disabled' : ''} onclick="loadOrders(${pagination.page - 1})">Previous</button>
              <button class="btn btn-sm btn-outline-primary" ${pagination.page === pagination.pages ? 'disabled' : ''} onclick="loadOrders(${pagination.page + 1})">Next</button>
            ` : ''}
          </div>
        `;
      } catch (e) {
        console.error(e);
      }
    }

    async function viewOrder(orderId) {
      try {
        const res = await fetch(`/api/orders/${orderId}`);
        const data = await res.json();
        const o = data.order;
        const history = o.history || [];

        const statusColors = {
          'new': 'info', 'confirmed': 'primary', 'preparing': 'warning',
          'ready': 'success', 'delivered': 'secondary', 'cancelled': 'danger'
        };

        document.getElementById('order-details').innerHTML = `
          <div class="row mb-3">
            <div class="col-md-6">
              <h5>Order ID: <code>${o.id}</code></h5>
              <p><strong>Status:</strong> <span class="badge bg-${statusColors[o.status]}">${o.status.toUpperCase()}</span></p>
              <p><strong>Type:</strong> ${o.order_type}</p>
              <p><strong>Created:</strong> ${new Date(o.created_at).toLocaleString()}</p>
            </div>
            <div class="col-md-6">
              <h6>Customer Info</h6>
              <p><strong>Name:</strong> ${o.customer_name || 'Unknown'}<br>
              <strong>Phone:</strong> ${o.customer_phone}<br>
              ${o.customer_address ? `<strong>Address:</strong> ${o.customer_address}<br>` : ''}
              <strong>Notes:</strong> ${o.notes || '-'}</p>
            </div>
          </div>
          
          <h6>Items</h6>
          <table class="table table-sm">
            <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
            <tbody>
              ${o.items.map(i => `
                <tr>
                  <td>${i.name}</td>
                  <td>${i.qty}</td>
                  <td>Rs. ${i.price}</td>
                  <td>Rs. ${i.qty * i.price}</td>
                </tr>
              `).join('')}
            </tbody>
            <tfoot>
              <tr><td colspan="3" class="text-end"><strong>Subtotal:</strong></td><td>Rs. ${o.subtotal}</td></tr>
              ${o.delivery_fee > 0 ? `<tr><td colspan="3" class="text-end"><strong>Delivery:</strong></td><td>Rs. ${o.delivery_fee}</td></tr>` : ''}
              <tr><td colspan="3" class="text-end"><strong>Total:</strong></td><td><strong>Rs. ${o.total}</strong></td></tr>
            </tfoot>
          </table>

          ${history.length > 0 ? `
            <h6>Status History</h6>
            <ul class="list-group">
              ${history.map(h => `
                <li class="list-group-item d-flex justify-content-between">
                  <span><span class="badge bg-${statusColors[h.status]}">${h.status}</span> ${h.note || ''}</span>
                  <small class="text-muted">${new Date(h.created_at).toLocaleString()}</small>
                </li>
              `).join('')}
            </ul>
          ` : ''}

          <div class="mt-3 d-flex gap-2 flex-wrap">
            ${o.status !== 'confirmed' && o.status !== 'cancelled' ? `<button onclick="updateStatus('${o.id}', 'confirmed')" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Confirm</button>` : ''}
            ${o.status !== 'preparing' && o.status !== 'cancelled' && o.status !== 'delivered' ? `<button onclick="updateStatus('${o.id}', 'preparing')" class="btn btn-warning btn-sm"><i class="fas fa-fire"></i> Preparing</button>` : ''}
            ${o.status !== 'ready' && o.status !== 'cancelled' && o.status !== 'delivered' ? `<button onclick="updateStatus('${o.id}', 'ready')" class="btn btn-info btn-sm"><i class="fas fa-bell"></i> Ready</button>` : ''}
            ${o.status !== 'delivered' && o.status !== 'cancelled' ? `<button onclick="updateStatus('${o.id}', 'delivered')" class="btn btn-success btn-sm"><i class="fas fa-check-double"></i> Delivered</button>` : ''}
            ${o.status !== 'cancelled' && o.status !== 'delivered' ? `<button onclick="cancelOrder('${o.id}')" class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Cancel</button>` : ''}
          </div>
        `;
        orderModal.show();
      } catch (e) {
        alert('Error loading order');
      }
    }

    async function updateStatus(orderId, status) {
      if (!confirm(`Order status to "${status}" update karein? Customer ko WhatsApp notification jayega.`)) return;
      try {
        const res = await fetch(`/api/orders/${orderId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status })
        });
        const data = await res.json();
        if (data.success) {
          loadOrders(currentPage);
          orderModal.hide();
        } else {
          alert(data.error || 'Failed');
        }
      } catch (e) {
        alert('Error');
      }
    }

    async function cancelOrder(orderId) {
      const reason = prompt('Cancel ki waja:');
      if (reason === null) return;
      try {
        const res = await fetch(`/api/orders/${orderId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'cancelled', reason })
        });
        const data = await res.json();
        if (data.success) {
          loadOrders(currentPage);
          orderModal.hide();
        }
      } catch (e) {
        alert('Error');
      }
    }

    function showStatusUpdate(orderId, currentStatus) {
      viewOrder(orderId);
    }

    function formatTime(timestamp) {
      const date = new Date(timestamp);
      const now = new Date();
      const diff = (now - date) / 1000 / 60; // minutes
      if (diff < 60) return Math.floor(diff) + ' min ago';
      if (diff < 1440) return Math.floor(diff / 60) + ' hr ago';
      return date.toLocaleDateString();
    }

    document.getElementById('search').addEventListener('input', (e) => {
      currentSearch = e.target.value;
      clearTimeout(window.searchTimeout);
      window.searchTimeout = setTimeout(() => loadOrders(1), 500);
    });

    if (Notification.permission === 'default') {
      Notification.requestPermission();
    }

    loadOrders();
    // Auto-refresh every 30 seconds
    setInterval(loadOrders, 30000);
  </script>
</body>
</html>
