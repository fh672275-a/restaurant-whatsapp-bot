<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Operating Hours - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
            <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/bulk-upload"><i class="fas fa-upload"></i> Bulk Upload</a>
        <a href="/restaurant/deals"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/marketing"><i class="fas fa-bullhorn"></i> Marketing</a>
        <a href="/restaurant/hours" class="active"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/delivery"><i class="fas fa-truck"></i> Delivery Areas</a>
        <a href="/restaurant/customers"><i class="fas fa-users"></i> Customers</a>
        <a href="/restaurant/feedback"><i class="fas fa-star"></i> Feedback</a>
        <a href="/restaurant/broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a>
        <a href="/restaurant/reservations"><i class="fas fa-calendar-check"></i> Reservations</a>
        <a href="/restaurant/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fas fa-clock"></i> Operating Hours</h1>
      </header>

      <div class="content-body">
        <div class="card">
          <div class="card-body">
            <div class="alert alert-info">
              <i class="fas fa-info-circle"></i>
              <strong>Note:</strong> Jab restaurant band ho, bot customer ko automatically batayega k abhi band hai. Customer phir bhi message kar sakta hai, lekin order nahi de sakta jab tak khul na jaye.
            </div>
            
            <h5 class="mb-3">Weekly Schedule</h5>
            <div id="hours-form"></div>
            
            <button onclick="saveHours()" class="btn btn-success mt-3">
              <i class="fas fa-save"></i> Save Hours
            </button>
          </div>
        </div>

        <div class="card mt-4">
          <div class="card-header"><h3>Quick Presets</h3></div>
          <div class="card-body">
            <button onclick="applyPreset('all_open')" class="btn btn-outline-primary me-2 mb-2">
              <i class="fas fa-clock"></i> Har Roz 11 AM - 11 PM
            </button>
            <button onclick="applyPreset('weekdays')" class="btn btn-outline-primary me-2 mb-2">
              <i class="fas fa-calendar-week"></i> Mon-Sat 9 AM - 11 PM, Sunday Band
            </button>
            <button onclick="applyPreset('24_7')" class="btn btn-outline-primary me-2 mb-2">
              <i class="fas fa-infinity"></i> 24/7 Open
            </button>
            <button onclick="applyPreset('closed_all')" class="btn btn-outline-danger mb-2">
              <i class="fas fa-times-circle"></i> Sab Band
            </button>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    let hoursData = [];

    async function loadRestaurant() {
      const res = await fetch('/api/restaurants/<%= user.id %>');
      const data = await res.json();
      document.getElementById('rest-name').textContent = data.restaurant.name;
    }

    async function loadHours() {
      const res = await fetch('/api/settings/hours');
      const data = await res.json();
      hoursData = data.hours || [];
      renderForm();
    }

    function renderForm() {
      const form = document.getElementById('hours-form');
      form.innerHTML = DAYS.map((day, i) => {
        const h = hoursData.find(h => h.day_of_week === i) || { is_closed: 0, open_time: '11:00', close_time: '23:00' };
        return `
          <div class="row mb-3 align-items-center">
            <div class="col-md-2"><strong>${day}</strong></div>
            <div class="col-md-2">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="closed-${i}" ${h.is_closed ? 'checked' : ''} onchange="toggleClosed(${i})">
                <label class="form-check-label" for="closed-${i}">Band</label>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Khulne ka waqt</label>
              <input type="time" class="form-control" id="open-${i}" value="${h.open_time || '11:00'}" ${h.is_closed ? 'disabled' : ''}>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Band hone ka waqt</label>
              <input type="time" class="form-control" id="close-${i}" value="${h.close_time || '23:00'}" ${h.is_closed ? 'disabled' : ''}>
            </div>
          </div>
        `;
      }).join('');
    }

    function toggleClosed(day) {
      const closed = document.getElementById(`closed-${day}`).checked;
      document.getElementById(`open-${day}`).disabled = closed;
      document.getElementById(`close-${day}`).disabled = closed;
    }

    function applyPreset(preset) {
      hoursData = [];
      for (let i = 0; i < 7; i++) {
        let h = { day_of_week: i, is_closed: 0, open_time: '11:00', close_time: '23:00' };
        if (preset === 'all_open') {
          h.open_time = '11:00'; h.close_time = '23:00';
        } else if (preset === 'weekdays') {
          if (i === 0) { h.is_closed = 1; }
          else { h.open_time = '09:00'; h.close_time = '23:00'; }
        } else if (preset === '24_7') {
          h.open_time = '00:00'; h.close_time = '23:59';
        } else if (preset === 'closed_all') {
          h.is_closed = 1;
        }
        hoursData.push(h);
      }
      renderForm();
    }

    async function saveHours() {
      const hours = DAYS.map((day, i) => ({
        day_of_week: i,
        is_closed: document.getElementById(`closed-${i}`).checked,
        open_time: document.getElementById(`open-${i}`).value,
        close_time: document.getElementById(`close-${i}`).value
      }));
      
      const res = await fetch('/api/settings/hours/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hours })
      });
      const data = await res.json();
      if (data.success) {
        alert('Hours save ho gaye! ✅');
        loadHours();
      } else {
        alert('Save failed');
      }
    }

    loadRestaurant();
    loadHours();
  </script>
</body>
</html>
