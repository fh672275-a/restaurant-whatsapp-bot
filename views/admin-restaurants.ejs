<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurants - Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div>
          <h2>Bot Admin</h2>
          <p>Super Admin</p>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/admin/restaurants" class="active"><i class="fas fa-store"></i> Restaurants</a>
        <a href="/admin/restaurants/new"><i class="fas fa-plus-circle"></i> Add Restaurant</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1>All Restaurants</h1>
        <a href="/admin/restaurants/new" class="btn btn-success">
          <i class="fas fa-plus"></i> Naya Restaurant
        </a>
      </header>

      <div class="content-body">
        <div class="card">
          <div class="card-body">
            <div class="row mb-3">
              <div class="col-md-6">
                <input type="text" class="form-control" id="search" placeholder="Search by name, phone...">
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>Phone</th>
                    <th>WhatsApp</th>
                    <th>Orders</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="restaurants-list">
                  <tr><td colspan="8" class="text-center">Loading...</td></tr>
                </tbody>
              </table>
            </div>
            <div id="pagination" class="d-flex justify-content-between mt-3"></div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    let currentPage = 1;
    let currentSearch = '';

    async function loadRestaurants(page = 1) {
      currentPage = page;
      try {
        const params = new URLSearchParams({ page, limit: 50 });
        if (currentSearch) params.set('search', currentSearch);
        const res = await fetch(`/api/restaurants?${params}`);
        const data = await res.json();
        const tbody = document.getElementById('restaurants-list');
        
        if (!data.restaurants || data.restaurants.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">Koi restaurant nahi mila. <a href="/admin/restaurants/new">Naya add karein</a></td></tr>';
          return;
        }
        
        tbody.innerHTML = data.restaurants.map(r => `
          <tr>
            <td><strong>${r.name}</strong></td>
            <td>${r.owner_name || '-'}</td>
            <td>${r.phone}</td>
            <td>
              ${r.whatsapp_connected 
                ? `<span class="badge bg-success"><i class="fab fa-whatsapp"></i> ${r.whatsapp_phone || 'Connected'}</span>` 
                : '<span class="badge bg-secondary">Not Connected</span>'}
            </td>
            <td>-</td>
            <td>
              ${r.is_active 
                ? '<span class="badge bg-success">Active</span>' 
                : '<span class="badge bg-danger">Inactive</span>'}
            </td>
            <td>${new Date(r.created_at).toLocaleDateString()}</td>
            <td>
              <a href="/admin/restaurants/${r.id}" class="btn btn-sm btn-outline-primary" title="View">
                <i class="fas fa-eye"></i>
              </a>
              <a href="/admin/restaurants/${r.id}/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                <i class="fas fa-edit"></i>
              </a>
              <button onclick="deleteRestaurant('${r.id}', '${r.name}')" class="btn btn-sm btn-outline-danger" title="Delete">
                <i class="fas fa-trash"></i>
              </button>
            </td>
          </tr>
        `).join('');

        // Pagination
        const pagination = data.pagination;
        const pag = document.getElementById('pagination');
        pag.innerHTML = `
          <div>Showing ${(pagination.page-1)*pagination.limit + 1}-${Math.min(pagination.page*pagination.limit, pagination.total)} of ${pagination.total}</div>
          <div>
            ${pagination.pages > 1 ? `
              <button class="btn btn-sm btn-outline-primary" ${pagination.page === 1 ? 'disabled' : ''} onclick="loadRestaurants(${pagination.page - 1})">Previous</button>
              <button class="btn btn-sm btn-outline-primary" ${pagination.page === pagination.pages ? 'disabled' : ''} onclick="loadRestaurants(${pagination.page + 1})">Next</button>
            ` : ''}
          </div>
        `;
      } catch (e) {
        console.error(e);
      }
    }

    async function deleteRestaurant(id, name) {
      if (!confirm(`"${name}" ko delete karein? Yeh action wapas nahi hoga.`)) return;
      try {
        await fetch(`/api/restaurants/${id}`, { method: 'DELETE' });
        loadRestaurants(currentPage);
      } catch (e) {
        alert('Delete failed');
      }
    }

    document.getElementById('search').addEventListener('input', (e) => {
      currentSearch = e.target.value;
      clearTimeout(window.searchTimeout);
      window.searchTimeout = setTimeout(() => loadRestaurants(1), 500);
    });

    loadRestaurants();
  </script>
</body>
</html>
