<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feedback - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
      <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/deals"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/hours"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/delivery"><i class="fas fa-truck"></i> Delivery Areas</a>
        <a href="/restaurant/customers"><i class="fas fa-users"></i> Customers</a>
        <a href="/restaurant/feedback" class="active"><i class="fas fa-star"></i> Feedback</a>
        <a href="/restaurant/broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a>
        <a href="/restaurant/reservations"><i class="fas fa-calendar-check"></i> Reservations</a>
        <a href="/restaurant/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fas fa-star"></i> Customer Feedback</h1>
      </header>

      <div class="content-body">
        <div class="stats-grid">
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-star"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="avg-rating">-</div>
              <div class="stat-label">Average Rating</div>
            </div>
          </div>
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fas fa-comments"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-feedback">-</div>
              <div class="stat-label">Total Feedback</div>
            </div>
          </div>
        </div>

        <div class="card mt-4">
          <div class="card-header"><h3>All Feedback</h3></div>
          <div class="card-body">
            <div id="feedback-list">
              <div class="text-center py-3 text-muted">Loading...</div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadRestaurant() {
      const res = await fetch('/api/restaurants/<%= user.id %>');
      const data = await res.json();
      document.getElementById('rest-name').textContent = data.restaurant.name;
    }

    async function loadFeedback() {
      const res = await fetch('/api/settings/feedback');
      const data = await res.json();
      
      document.getElementById('avg-rating').textContent = (data.stats.avg_rating || 0).toFixed(1) + ' ⭐';
      document.getElementById('total-feedback').textContent = data.stats.total || 0;
      
      const list = document.getElementById('feedback-list');
      if (!data.feedback || data.feedback.length === 0) {
        list.innerHTML = '<div class="text-center py-4 text-muted">Abhi koi feedback nahi mila. Customers k orders deliver hone k baad automatically feedback request jayegi.</div>';
        return;
      }
      
      list.innerHTML = data.feedback.map(f => `
        <div class="card mb-2">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <div>
                <strong>${f.customer_name || 'Anonymous'}</strong>
                <small class="text-muted ms-2">${f.customer_phone}</small>
              </div>
              <div>
                ${'⭐'.repeat(f.rating)}<span class="text-muted">${'☆'.repeat(5 - f.rating)}</span>
                <span class="badge bg-${f.rating >= 4 ? 'success' : f.rating >= 3 ? 'warning' : 'danger'} ms-2">${f.rating}/5</span>
              </div>
            </div>
            ${f.comment ? `<p class="mt-2 mb-0">${f.comment}</p>` : ''}
            <small class="text-muted">${new Date(f.created_at).toLocaleString()}</small>
            ${f.order_total ? `<small class="text-muted ms-3">Order: Rs. ${f.order_total}</small>` : ''}
          </div>
        </div>
      `).join('');
    }

    loadRestaurant();
    loadFeedback();
  </script>
</body>
</html>
