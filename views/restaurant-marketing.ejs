<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Marketing - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
            <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/bulk-upload"><i class="fas fa-upload"></i> Bulk Upload</a>
        <a href="/restaurant/deals"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/marketing" class="active"><i class="fas fa-bullhorn"></i> Marketing</a>
        <a href="/restaurant/pricing"><i class="fas fa-credit-card"></i> Plans & Billing</a>
        <a href="/restaurant/hours"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/delivery"><i class="fas fa-truck"></i> Delivery Areas</a>
        <a href="/restaurant/customers"><i class="fas fa-users"></i> Customers</a>
        <a href="/restaurant/feedback"><i class="fas fa-star"></i> Feedback</a>
        <a href="/restaurant/broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a>
        <a href="/restaurant/reservations"><i class="fas fa-calendar-check"></i> Reservations</a>
        <a href="/restaurant/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fas fa-bullhorn"></i> Marketing & Ads</h1>
      </header>

      <div class="content-body">
        <div class="alert alert-info">
          <i class="fas fa-info-circle"></i>
          AI-powered marketing messages! Apne customers ko WhatsApp par promotional messages bhejein - deals, festivals, new items, etc.
        </div>

        <!-- Generate New Ad -->
        <div class="card mb-4">
          <div class="card-header"><h3><i class="fas fa-magic"></i> Naya Ad Generate Karein</h3></div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label">Campaign Type</label>
                <select class="form-control" id="campaign-type">
                  <option value="deal">Special Deal Promotion</option>
                  <option value="festival">Festival Greeting (Eid, Ramadan, etc)</option>
                  <option value="new_item">New Menu Item Launch</option>
                  <option value="discount">Discount Offer</option>
                  <option value="weekend_special">Weekend Special</option>
                  <option value="anniversary">Restaurant Anniversary</option>
                  <option value="general">General Promotion</option>
                </select>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label">Custom Details (optional)</label>
                <input type="text" class="form-control" id="custom-details" placeholder="e.g., 20% off on all biryani">
              </div>
            </div>
            <button onclick="generateAd()" class="btn btn-success" id="generate-btn">
              <i class="fas fa-magic"></i> AI se Ad Generate Karein
            </button>
          </div>
        </div>

        <!-- Generated Messages -->
        <div id="generated-messages" class="mb-4"></div>

        <!-- Saved Campaigns -->
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-list"></i> Saved Campaigns</h3></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Type</th>
                    <th>Target</th>
                    <th>Status</th>
                    <th>Sent</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="campaigns-list">
                  <tr><td colspan="7" class="text-center">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function generateAd() {
      const type = document.getElementById('campaign-type').value;
      const customDetails = document.getElementById('custom-details').value;
      const btn = document.getElementById('generate-btn');
      
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> AI Generate kar raha hai...';
      
      try {
        const res = await fetch('/api/marketing/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, customDetails })
        });
        const data = await res.json();
        
        if (data.success) {
          const messagesDiv = document.getElementById('generated-messages');
          const imageAds = data.imageAds || [];
          const textAds = data.variations || [];
          
          let html = '<div class="card"><div class="card-header"><h3>Generated Ads</h3></div><div class="card-body">';
          
          // Show IMAGE ads first (visual cards)
          if (imageAds.length > 0) {
            html += '<h5 class="mb-3"><i class="fas fa-image text-primary"></i> Image Ads (Download & Share)</h5>';
            html += '<div class="row">';
            imageAds.forEach((ad, i) => {
              html += \`
                <div class="col-md-4 mb-3">
                  <div class="card" style="border:2px solid #25D366;">
                    <div class="card-body p-0">
                      <div id="ad-image-\${i}" style="padding:0;">
                        \${ad.html}
                      </div>
                    </div>
                    <div class="card-footer text-center">
                      <button onclick="downloadAd(\${i})" class="btn btn-primary btn-sm">
                        <i class="fas fa-download"></i> Download Image
                      </button>
                      <button onclick='sendNow(\${JSON.stringify(ad.text)}, "\${type}")' class="btn btn-success btn-sm">
                        <i class="fas fa-paper-plane"></i> Send
                      </button>
                    </div>
                  </div>
                </div>
              \`;
            });
            html += '</div><hr>';
          }
          
          // Show TEXT ads
          html += '<h5 class="mb-3"><i class="fas fa-font text-success"></i> Text Ads</h5>';
          textAds.forEach((msg, i) => {
            html += \`
              <div class="card mb-2">
                <div class="card-body">
                  <p style="white-space: pre-wrap; margin:0;">\${msg}</p>
                  <div class="mt-2">
                    <button onclick='saveCampaign(\${JSON.stringify(msg)}, "\${type}")' class="btn btn-primary btn-sm">
                      <i class="fas fa-save"></i> Save
                    </button>
                    <button onclick='sendNow(\${JSON.stringify(msg)}, "\${type}")' class="btn btn-success btn-sm">
                      <i class="fas fa-paper-plane"></i> Send
                    </button>
                  </div>
                </div>
              </div>
            \`;
          });
          
          html += '</div></div>';
          messagesDiv.innerHTML = html;
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Error: ' + e.message);
      }
      
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-magic"></i> AI se Ad Generate Karein';
    }

    // Download image ad as PNG using canvas
    function downloadAd(index) {
      const adDiv = document.getElementById('ad-image-' + index);
      if (!adDiv) return;
      
      // Use html2canvas approach - create a canvas and draw the HTML
      // For simplicity, we'll open the ad in a new window for screenshot
      const win = window.open('', '_blank');
      win.document.write(`
        <html><head><title>Ad Image ${index + 1}</title></head>
        <body style="margin:0;padding:20px;background:#f0f0f0;">
          ${adDiv.innerHTML}
          <p style="text-align:center;margin-top:10px;">
            <button onclick="window.print()" style="padding:10px 20px;background:#25D366;color:white;border:none;border-radius:8px;cursor:pointer;">
              Print / Save as PDF
            </button>
          </p>
        </body></html>
      `);
      win.document.close();
    }

    async function saveCampaign(message, type) {
      const title = prompt('Campaign ka naam:');
      if (!title) return;
      
      const target = prompt('Target audience (all/vip/recent):', 'all') || 'all';
      
      try {
        const res = await fetch('/api/marketing/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, message, type, target_audience: target })
        });
        const data = await res.json();
        if (data.success) {
          alert('Campaign saved!');
          loadCampaigns();
        }
      } catch (e) {
        alert('Error');
      }
    }

    async function sendNow(message, type) {
      if (!confirm('Yeh message abhi sab customers ko bhej diya jayega. Continue?')) return;
      
      const target = prompt('Target audience (all/vip/recent):', 'all') || 'all';
      
      // Save first
      try {
        const saveRes = await fetch('/api/marketing/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: 'Quick Send - ' + new Date().toLocaleString(), message, type, target_audience: target })
        });
        const saveData = await saveRes.json();
        
        if (saveData.success) {
          // Send
          const sendRes = await fetch(`/api/marketing/campaigns/${saveData.id}/send`, { method: 'POST' });
          const sendData = await sendRes.json();
          if (sendData.success) {
            alert(`✅ Sent to ${sendData.sent} customers!${sendData.failed ? ' Failed: ' + sendData.failed : ''}`);
            loadCampaigns();
          }
        }
      } catch (e) {
        alert('Error');
      }
    }

    async function loadCampaigns() {
      const res = await fetch('/api/marketing/campaigns');
      const data = await res.json();
      const list = document.getElementById('campaigns-list');
      
      if (!data.campaigns || data.campaigns.length === 0) {
        list.innerHTML = '<tr><td colspan="7" class="text-center py-3">Koi campaign nahi hai. Naya ad generate karein!</td></tr>';
        return;
      }
      
      list.innerHTML = data.campaigns.map(c => `
        <tr>
          <td><strong>${c.title}</strong></td>
          <td><small>${(c.message || '').substring(0, 50)}...</small></td>
          <td><span class="badge bg-info">${c.type}</span></td>
          <td><span class="badge bg-secondary">${c.target_audience}</span></td>
          <td>${c.status === 'sent' ? '<span class="badge bg-success">Sent</span>' : '<span class="badge bg-warning">Draft</span>'}</td>
          <td>${c.sent_count || 0}</td>
          <td>
            ${c.status !== 'sent' ? `<button onclick="sendCampaign('${c.id}')" class="btn btn-sm btn-success"><i class="fas fa-paper-plane"></i></button>` : ''}
            <button onclick="deleteCampaign('${c.id}')" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `).join('');
    }

    async function sendCampaign(id) {
      if (!confirm('Send this campaign to all customers?')) return;
      try {
        const res = await fetch(`/api/marketing/campaigns/${id}/send`, { method: 'POST' });
        const data = await res.json();
        alert(`Sent to ${data.sent} customers!${data.failed ? ' Failed: ' + data.failed : ''}`);
        loadCampaigns();
      } catch (e) {
        alert('Error');
      }
    }

    async function deleteCampaign(id) {
      if (!confirm('Delete?')) return;
      await fetch(`/api/marketing/campaigns/${id}`, { method: 'DELETE' });
      loadCampaigns();
    }

    // Load
    fetch('/api/restaurants/<%= user.id %>').then(r => r.json()).then(d => {
      document.getElementById('rest-name').textContent = d.restaurant.name;
    });
    loadCampaigns();
  </script>
</body>
</html>
