<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Deals Management - Restaurant Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo"><i class="fab fa-whatsapp"></i></div>
        <div><h2 id="rest-name">Restaurant</h2><p>Owner Panel</p></div>
      </div>
            <nav class="sidebar-nav">
        <a href="/restaurant/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/restaurant/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
        <a href="/restaurant/menu"><i class="fas fa-utensils"></i> Menu</a>
        <a href="/restaurant/bulk-upload"><i class="fas fa-upload"></i> Bulk Upload</a>
        <a href="/restaurant/deals" class="active"><i class="fas fa-tags"></i> Deals</a>
        <a href="/restaurant/marketing"><i class="fas fa-bullhorn"></i> Marketing</a>
        <a href="/restaurant/hours"><i class="fas fa-clock"></i> Hours</a>
        <a href="/restaurant/delivery"><i class="fas fa-truck"></i> Delivery Areas</a>
        <a href="/restaurant/customers"><i class="fas fa-users"></i> Customers</a>
        <a href="/restaurant/feedback"><i class="fas fa-star"></i> Feedback</a>
        <a href="/restaurant/broadcasts"><i class="fas fa-bullhorn"></i> Broadcasts</a>
        <a href="/restaurant/reservations"><i class="fas fa-calendar-check"></i> Reservations</a>
        <a href="/restaurant/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/restaurant/whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <a href="/restaurant/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-content">
      <header class="top-bar">
        <h1><i class="fas fa-tags"></i> Deals & Packages</h1>
        <button onclick="showAddDealModal()" class="btn btn-success">
          <i class="fas fa-plus"></i> Naya Deal
        </button>
      </header>

      <div class="content-body">
        <div class="stats-grid mb-4">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="fas fa-tags"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-deals">0</div>
              <div class="stat-label">Total Deals</div>
            </div>
          </div>
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fas fa-fire"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="active-deals">0</div>
              <div class="stat-label">Active Deals</div>
            </div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-percentage"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-savings">Rs. 0</div>
              <div class="stat-label">Customer Savings</div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3>All Deals</h3></div>
          <div class="card-body">
            <div id="deals-list" class="row">
              <div class="text-center py-4 text-muted">Loading deals...</div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Add/Edit Deal Modal -->
  <div class="modal fade" id="dealModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="dealModalTitle">Naya Deal Banayein</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="deal-id">
          <div class="row">
            <div class="col-md-8 mb-3">
              <label class="form-label">Deal Name *</label>
              <input type="text" class="form-control" id="deal-name" placeholder="Family Combo Deal" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Status</label>
              <select class="form-control" id="deal-active">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" id="deal-description" rows="2" placeholder="Family k liye complete meal deal"></textarea>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Original Price (Rs.)</label>
              <input type="number" step="0.01" class="form-control" id="deal-original-price" placeholder="1500">
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Deal Price (Rs.) *</label>
              <input type="number" step="0.01" class="form-control" id="deal-price" placeholder="1200" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Sort Order</label>
              <input type="number" class="form-control" id="deal-sort" value="0">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Valid From</label>
              <input type="datetime-local" class="form-control" id="deal-valid-from">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Valid Until</label>
              <input type="datetime-local" class="form-control" id="deal-valid-until">
            </div>
          </div>
          
          <hr>
          <h6><i class="fas fa-list"></i> Deal Items</h6>
          <div id="deal-items-list" class="mb-2"></div>
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <select class="form-control" id="new-item-menu">
                <option value="">Select Menu Item</option>
              </select>
            </div>
            <div class="col-md-3">
              <input type="number" class="form-control" id="new-item-qty" placeholder="Qty" value="1" min="1">
            </div>
            <div class="col-md-3">
              <button onclick="addDealItemRow()" class="btn btn-primary w-100">
                <i class="fas fa-plus"></i> Add
              </button>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" onclick="saveDeal()">Save Deal</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const dealModal = new bootstrap.Modal(document.getElementById('dealModal'));
    let currentDealItems = [];
    let menuItemsCache = [];

    async function loadRestaurant() {
      const res = await fetch('/api/restaurants/<%= user.id %>');
      const data = await res.json();
      document.getElementById('rest-name').textContent = data.restaurant.name;
    }

    async function loadMenuItems() {
      const res = await fetch('/api/menus/items');
      const data = await res.json();
      menuItemsCache = data.items || [];
      const select = document.getElementById('new-item-menu');
      select.innerHTML = '<option value="">Select Menu Item</option>' + 
        menuItemsCache.map(i => `<option value="${i.id}">${i.name} (Rs. ${i.price})</option>`).join('');
    }

    async function loadDeals() {
      const res = await fetch('/api/deals');
      const data = await res.json();
      const deals = data.deals || [];
      
      document.getElementById('total-deals').textContent = deals.length;
      document.getElementById('active-deals').textContent = deals.filter(d => d.is_active).length;
      const savings = deals.filter(d => d.is_active && d.original_price).reduce((s, d) => s + (d.original_price - d.deal_price), 0);
      document.getElementById('total-savings').textContent = 'Rs. ' + savings.toLocaleString();
      
      const list = document.getElementById('deals-list');
      if (deals.length === 0) {
        list.innerHTML = '<div class="col-12 text-center py-4 text-muted">Koi deal nahi hai. Naya deal add karein!</div>';
        return;
      }
      
      list.innerHTML = deals.map(deal => `
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="card h-100 ${deal.is_active ? '' : 'opacity-50'}">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 class="text-success">${deal.name}</h5>
                ${deal.is_active ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'}
              </div>
              ${deal.description ? `<p class="text-muted small">${deal.description}</p>` : ''}
              <div class="mb-2">
                ${deal.original_price ? `<span class="text-decoration-line-through text-muted me-2">Rs. ${deal.original_price}</span>` : ''}
                <span class="fs-4 text-success fw-bold">Rs. ${deal.deal_price}</span>
              </div>
              ${deal.items && deal.items.length > 0 ? `
                <div class="small">
                  <strong>Includes:</strong>
                  <ul class="list-unstyled mt-1">
                    ${deal.items.map(i => `<li>• ${i.quantity}x ${i.custom_name || i.item_name || 'Item'}</li>`).join('')}
                  </ul>
                </div>
              ` : ''}
              <div class="mt-2">
                <button onclick="editDeal(${JSON.stringify(deal).replace(/"/g, '&quot;')})" class="btn btn-sm btn-outline-primary">
                  <i class="fas fa-edit"></i>
                </button>
                <button onclick="toggleDeal('${deal.id}', ${!deal.is_active})" class="btn btn-sm btn-outline-warning">
                  <i class="fas fa-${deal.is_active ? 'pause' : 'play'}"></i>
                </button>
                <button onclick="deleteDeal('${deal.id}', '${deal.name}')" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    }

    function showAddDealModal() {
      document.getElementById('dealModalTitle').textContent = 'Naya Deal Banayein';
      document.getElementById('deal-id').value = '';
      document.getElementById('deal-name').value = '';
      document.getElementById('deal-description').value = '';
      document.getElementById('deal-original-price').value = '';
      document.getElementById('deal-price').value = '';
      document.getElementById('deal-sort').value = '0';
      document.getElementById('deal-active').value = '1';
      document.getElementById('deal-valid-from').value = '';
      document.getElementById('deal-valid-until').value = '';
      currentDealItems = [];
      renderDealItems();
      dealModal.show();
    }

    function editDeal(deal) {
      document.getElementById('dealModalTitle').textContent = 'Edit Deal';
      document.getElementById('deal-id').value = deal.id;
      document.getElementById('deal-name').value = deal.name;
      document.getElementById('deal-description').value = deal.description || '';
      document.getElementById('deal-original-price').value = deal.original_price || '';
      document.getElementById('deal-price').value = deal.deal_price;
      document.getElementById('deal-sort').value = deal.sort_order || 0;
      document.getElementById('deal-active').value = deal.is_active ? '1' : '0';
      currentDealItems = (deal.items || []).map(i => ({
        menu_item_id: i.menu_item_id,
        custom_name: i.custom_name,
        quantity: i.quantity,
        name: i.item_name || i.custom_name
      }));
      renderDealItems();
      dealModal.show();
    }

    function addDealItemRow() {
      const itemId = document.getElementById('new-item-menu').value;
      const qty = parseInt(document.getElementById('new-item-qty').value) || 1;
      if (!itemId) {
        alert('Pehle item select karein');
        return;
      }
      const item = menuItemsCache.find(i => i.id === itemId);
      currentDealItems.push({
        menu_item_id: itemId,
        quantity: qty,
        name: item.name
      });
      renderDealItems();
      document.getElementById('new-item-menu').value = '';
      document.getElementById('new-item-qty').value = '1';
    }

    function removeDealItem(idx) {
      currentDealItems.splice(idx, 1);
      renderDealItems();
    }

    function renderDealItems() {
      const list = document.getElementById('deal-items-list');
      if (currentDealItems.length === 0) {
        list.innerHTML = '<small class="text-muted">Koi item add nahi hai</small>';
        return;
      }
      list.innerHTML = currentDealItems.map((item, i) => `
        <div class="d-flex justify-content-between align-items-center border-bottom py-1">
          <span>${item.quantity}x ${item.name}</span>
          <button onclick="removeDealItem(${i})" class="btn btn-sm btn-link text-danger">
            <i class="fas fa-times"></i>
          </button>
        </div>
      `).join('');
    }

    async function saveDeal() {
      const id = document.getElementById('deal-id').value;
      const data = {
        name: document.getElementById('deal-name').value,
        description: document.getElementById('deal-description').value,
        original_price: parseFloat(document.getElementById('deal-original-price').value) || null,
        deal_price: parseFloat(document.getElementById('deal-price').value),
        sort_order: parseInt(document.getElementById('deal-sort').value) || 0,
        is_active: document.getElementById('deal-active').value === '1',
        valid_from: document.getElementById('deal-valid-from').value || null,
        valid_until: document.getElementById('deal-valid-until').value || null,
        items: currentDealItems
      };
      if (!data.name || isNaN(data.deal_price)) {
        alert('Name aur deal price zaruri hain');
        return;
      }
      const url = id ? `/api/deals/${id}` : '/api/deals';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        dealModal.hide();
        loadDeals();
      } else {
        alert(result.error || 'Failed');
      }
    }

    async function toggleDeal(id, active) {
      await fetch(`/api/deals/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active: active })
      });
      loadDeals();
    }

    async function deleteDeal(id, name) {
      if (!confirm(`"${name}" delete karein?`)) return;
      await fetch(`/api/deals/${id}`, { method: 'DELETE' });
      loadDeals();
    }

    loadRestaurant();
    loadMenuItems();
    loadDeals();
  </script>
</body>
</html>
