<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant Registration - WhatsApp Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', -apple-system, sans-serif;
      padding: 20px;
    }
    .reg-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      max-width: 500px;
      width: 100%;
      padding: 40px;
    }
    .logo {
      text-align: center;
      margin-bottom: 25px;
    }
    .logo-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 32px;
      margin-bottom: 12px;
    }
    .logo h1 {
      font-size: 22px;
      color: #075E54;
      margin: 0;
      font-weight: 700;
    }
    .logo p {
      color: #888;
      font-size: 13px;
      margin: 4px 0 0;
    }
    .step-indicator {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      position: relative;
    }
    .step-indicator::before {
      content: '';
      position: absolute;
      top: 15px;
      left: 20%;
      right: 20%;
      height: 2px;
      background: #e0e0e0;
      z-index: 0;
    }
    .step {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #e0e0e0;
      color: #999;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 14px;
      z-index: 1;
      transition: all 0.3s;
    }
    .step.active {
      background: #25D366;
      color: white;
    }
    .step.done {
      background: #128C7E;
      color: white;
    }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #555;
      margin-bottom: 6px;
    }
    .form-control {
      width: 100%;
      padding: 12px 14px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 14px;
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: #25D366;
      box-shadow: 0 0 0 3px rgba(37,211,102,0.1);
    }
    .btn-primary-custom {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.1s;
    }
    .btn-primary-custom:hover { transform: translateY(-1px); }
    .btn-primary-custom:active { transform: scale(0.98); }
    .btn-primary-custom:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .alert {
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
    }
    .alert-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
    .alert-danger { background: #ffeef0; color: #c62828; border: 1px solid #ef9a9a; }
    .alert-info { background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; }
    .otp-display {
      background: #f0f7ff;
      border: 2px dashed #25D366;
      padding: 15px;
      border-radius: 10px;
      text-align: center;
      margin: 15px 0;
      display: none;
    }
    .otp-display .code {
      font-size: 32px;
      font-weight: bold;
      color: #075E54;
      letter-spacing: 8px;
    }
    .login-link {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
      color: #666;
    }
    .login-link a {
      color: #25D366;
      font-weight: 600;
      text-decoration: none;
    }
    .hidden { display: none !important; }
    .timer {
      font-size: 12px;
      color: #999;
      text-align: center;
      margin-top: 5px;
    }
  </style>
</head>
<body>
  <div class="reg-card">
    <div class="logo">
      <div class="logo-icon"><i class="fab fa-whatsapp"></i></div>
      <h1>Restaurant Sign Up</h1>
      <p>Apna restaurant register karein - bilkul free!</p>
    </div>

    <!-- Step Indicator -->
    <div class="step-indicator">
      <div class="step active" id="step1-ind">1</div>
      <div class="step" id="step2-ind">2</div>
      <div class="step" id="step3-ind">3</div>
    </div>

    <div id="alert" class="alert"></div>

    <!-- Step 1: Phone Verification -->
    <div id="step1">
      <h5 class="mb-3"><i class="fas fa-phone"></i> Phone Verification</h5>
      <div class="form-group">
        <label>WhatsApp Phone Number *</label>
        <input type="tel" class="form-control" id="phone" placeholder="03XXXXXXXXX" maxlength="11">
        <small class="text-muted">Yeh number aap ki restaurant login k liye use hoga</small>
      </div>
      <button onclick="sendOTP()" class="btn-primary-custom" id="send-otp-btn">
        <i class="fas fa-paper-plane"></i> OTP Bhejein
      </button>
    </div>

    <!-- Step 2: OTP Verification -->
    <div id="step2" class="hidden">
      <h5 class="mb-3"><i class="fas fa-shield-alt"></i> OTP Verification</h5>
      <p class="text-muted small">Aap k WhatsApp par 6-digit code bheja gaya hai.</p>
      
      <div class="otp-display" id="otp-display">
        <small class="text-muted">Demo Mode - Aap ka OTP:</small>
        <div class="code" id="otp-code">------</div>
        <small class="text-muted">(WhatsApp connect hone par automatic bheja jayega)</small>
      </div>
      
      <div class="form-group">
        <label>6-Digit OTP *</label>
        <input type="text" class="form-control text-center" id="otp" placeholder="000000" maxlength="6" style="font-size: 24px; letter-spacing: 8px;">
      </div>
      <button onclick="verifyOTP()" class="btn-primary-custom" id="verify-otp-btn">
        <i class="fas fa-check"></i> Verify OTP
      </button>
      <button onclick="resendOTP()" class="btn btn-link w-100 mt-2" style="color: #25D366; font-size: 13px;">
        OTP dobara bhejein
      </button>
      <div class="timer" id="timer"></div>
    </div>

    <!-- Step 3: Restaurant Details -->
    <div id="step3" class="hidden">
      <h5 class="mb-3"><i class="fas fa-store"></i> Restaurant Details</h5>
      
      <div class="form-group">
        <label>Restaurant Name *</label>
        <input type="text" class="form-control" id="name" placeholder="Al-Madina Restaurant">
      </div>
      <div class="form-group">
        <label>Owner Name</label>
        <input type="text" class="form-control" id="owner_name" placeholder="Ahmed Khan">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" id="email" placeholder="restaurant@example.com">
      </div>
      <div class="form-group">
        <label>Address</label>
        <textarea class="form-control" id="address" rows="2" placeholder="Gulshan-e-Iqbal, Karachi"></textarea>
      </div>
      <div class="form-group">
        <label>Password * (min 6 characters)</label>
        <input type="password" class="form-control" id="password" placeholder="••••••••">
      </div>
      <div class="form-group">
        <label>Confirm Password *</label>
        <input type="password" class="form-control" id="confirm_password" placeholder="••••••••">
      </div>
      <input type="hidden" id="verified_phone">
      <button onclick="completeSignup()" class="btn-primary-custom" id="signup-btn">
        <i class="fas fa-user-plus"></i> Account Banayein
      </button>
    </div>

    <div class="login-link">
      Pehle se account hai? <a href="/login">Login karein</a>
    </div>
  </div>

  <script>
    let registeredPhone = '';
    let currentOTP = '';
    let timerInterval = null;

    function showAlert(msg, type = 'danger') {
      const alert = document.getElementById('alert');
      alert.className = `alert alert-${type}`;
      alert.innerHTML = msg;
      alert.style.display = 'block';
      window.scrollTo(0, 0);
    }

    function hideAlert() {
      document.getElementById('alert').style.display = 'none';
    }

    async function sendOTP() {
      hideAlert();
      const phone = document.getElementById('phone').value.trim();
      if (!phone) return showAlert('Phone number likhein');
      if (phone.replace(/[^0-9]/g, '').length < 10) return showAlert('Sahi phone number likhein (11 digits)');
      
      const btn = document.getElementById('send-otp-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Bhej raha hai...';
      
      try {
        const res = await fetch('/api/auth/restaurant/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone })
        });
        const data = await res.json();
        
        if (data.success) {
          registeredPhone = phone.replace(/[^0-9]/g, '');
          if (registeredPhone.startsWith('92')) registeredPhone = '0' + registeredPhone.substring(2);
          if (!registeredPhone.startsWith('0')) registeredPhone = '0' + registeredPhone;
          
          document.getElementById('verified_phone').value = registeredPhone;
          
          // Show OTP on screen if demo mode
          if (!data.sentViaWhatsApp && data.otp) {
            currentOTP = data.otp;
            document.getElementById('otp-display').style.display = 'block';
            document.getElementById('otp-code').textContent = data.otp;
          }
          
          showAlert(data.message, 'success');
          
          // Move to step 2
          document.getElementById('step1').classList.add('hidden');
          document.getElementById('step2').classList.remove('hidden');
          document.getElementById('step1-ind').classList.remove('active');
          document.getElementById('step1-ind').classList.add('done');
          document.getElementById('step2-ind').classList.add('active');
          
          startTimer(600); // 10 min
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-paper-plane"></i> OTP Bhejein';
        }
      } catch (e) {
        showAlert('Connection error. Try again.');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> OTP Bhejein';
      }
    }

    async function verifyOTP() {
      hideAlert();
      const otp = document.getElementById('otp').value.trim();
      if (!otp || otp.length !== 6) return showAlert('6-digit OTP likhein');
      
      const btn = document.getElementById('verify-otp-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verify ho raha hai...';
      
      try {
        const res = await fetch('/api/auth/restaurant/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone: registeredPhone, otp })
        });
        const data = await res.json();
        
        if (data.success) {
          showAlert('OTP verify ho gaya! Ab details bharein.', 'success');
          
          // Move to step 3
          document.getElementById('step2').classList.add('hidden');
          document.getElementById('step3').classList.remove('hidden');
          document.getElementById('step2-ind').classList.remove('active');
          document.getElementById('step2-ind').classList.add('done');
          document.getElementById('step3-ind').classList.add('active');
          
          if (timerInterval) clearInterval(timerInterval);
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> Verify OTP';
        }
      } catch (e) {
        showAlert('Connection error');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> Verify OTP';
      }
    }

    async function resendOTP() {
      hideAlert();
      document.getElementById('otp').value = '';
      await sendOTP();
    }

    async function completeSignup() {
      hideAlert();
      const name = document.getElementById('name').value.trim();
      const owner_name = document.getElementById('owner_name').value.trim();
      const email = document.getElementById('email').value.trim();
      const address = document.getElementById('address').value.trim();
      const password = document.getElementById('password').value;
      const confirm_password = document.getElementById('confirm_password').value;
      const phone = document.getElementById('verified_phone').value;
      const otp = document.getElementById('otp').value;
      
      if (!name) return showAlert('Restaurant name likhein');
      if (!password) return showAlert('Password likhein');
      if (password.length < 6) return showAlert('Password kam azkam 6 characters ka ho');
      if (password !== confirm_password) return showAlert('Passwords match nahi karte');
      
      const btn = document.getElementById('signup-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Account ban raha hai...';
      
      try {
        const res = await fetch('/api/auth/restaurant/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, owner_name, phone, email, address, password, confirm_password, otp })
        });
        const data = await res.json();
        
        if (data.success) {
          showAlert('Account ban gaya! Redirecting...', 'success');
          setTimeout(() => {
            window.location.href = data.redirect || '/restaurant/dashboard';
          }, 1500);
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-user-plus"></i> Account Banayein';
        }
      } catch (e) {
        showAlert('Connection error');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-user-plus"></i> Account Banayein';
      }
    }

    function startTimer(seconds) {
      const timerEl = document.getElementById('timer');
      let timeLeft = seconds;
      
      if (timerInterval) clearInterval(timerInterval);
      
      timerInterval = setInterval(() => {
        const min = Math.floor(timeLeft / 60);
        const sec = timeLeft % 60;
        timerEl.textContent = `OTP expires in: ${min}:${sec.toString().padStart(2, '0')}`;
        
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          timerEl.textContent = 'OTP expired! Dobari request karein.';
          timerEl.style.color = '#dc3545';
        }
        timeLeft--;
      }, 1000);
    }

    // Enter key support
    document.getElementById('phone').addEventListener('keypress', e => {
      if (e.key === 'Enter') sendOTP();
    });
    document.getElementById('otp').addEventListener('keypress', e => {
      if (e.key === 'Enter') verifyOTP();
    });
  </script>
</body>
</html>
