<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant WhatsApp Bot - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', -apple-system, sans-serif;
    }
    .login-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      max-width: 420px;
      width: 100%;
      padding: 40px;
      overflow: hidden;
    }
    .logo {
      text-align: center;
      margin-bottom: 30px;
    }
    .logo-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 32px;
      margin-bottom: 12px;
    }
    .logo h1 {
      font-size: 22px;
      color: #075E54;
      margin: 0;
      font-weight: 700;
    }
    .logo p {
      color: #888;
      font-size: 13px;
      margin: 4px 0 0;
    }
    .form-tabs {
      display: flex;
      background: #f0f2f5;
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 24px;
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      text-align: center;
      border: none;
      background: transparent;
      color: #666;
      font-weight: 600;
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.2s;
      font-size: 14px;
    }
    .tab-btn.active {
      background: white;
      color: #075E54;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #555;
      margin-bottom: 6px;
    }
    .form-control {
      width: 100%;
      padding: 12px 14px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 14px;
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: #25D366;
      box-shadow: 0 0 0 3px rgba(37,211,102,0.1);
    }
    .btn-login {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.1s;
    }
    .btn-login:active { transform: scale(0.98); }
    .info-box {
      background: #f0f7ff;
      border-left: 4px solid #25D366;
      padding: 12px 16px;
      border-radius: 6px;
      margin-top: 20px;
      font-size: 12px;
      color: #555;
    }
    .info-box strong { color: #075E54; }
    .alert {
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
    }
    .alert-danger {
      background: #ffeef0;
      color: #c81e2c;
      border: 1px solid #ffcdd2;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="logo">
      <div class="logo-icon"><i class="fab fa-whatsapp"></i></div>
      <h1>Restaurant Bot</h1>
      <p>Order Management System</p>
    </div>

    <div class="form-tabs">
      <button class="tab-btn active" onclick="switchTab('restaurant', this)">
        <i class="fas fa-store"></i> Restaurant
      </button>
      <button class="tab-btn" onclick="switchTab('admin', this)">
        <i class="fas fa-user-shield"></i> Admin
      </button>
    </div>

    <div id="alert" class="alert alert-danger"></div>

    <!-- Restaurant Login -->
    <form id="restaurant-form" onsubmit="loginRestaurant(event)">
      <div class="form-group">
        <label>Phone Number</label>
        <input type="text" class="form-control" id="r-phone" placeholder="03001234567" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" id="r-password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn-login">
        <i class="fas fa-sign-in-alt"></i> Login karein
      </button>
    </form>

    <!-- Admin Login -->
    <form id="admin-form" style="display: none;" onsubmit="loginAdmin(event)">
      <div class="form-group">
        <label>Username</label>
        <input type="text" class="form-control" id="a-username" placeholder="admin" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" id="a-password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn-login">
        <i class="fas fa-sign-in-alt"></i> Admin Login
      </button>
    </form>

    <div class="info-box">
      <strong>Admin Login:</strong> admin / admin123<br>
      <strong>Restaurant:</strong> Apne phone aur password se login karein
    </div>
  </div>

  <script>
    function switchTab(tab, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('restaurant-form').style.display = tab === 'restaurant' ? 'block' : 'none';
      document.getElementById('admin-form').style.display = tab === 'admin' ? 'block' : 'none';
      hideAlert();
    }

    function showAlert(msg) {
      const alert = document.getElementById('alert');
      alert.textContent = msg;
      alert.style.display = 'block';
    }

    function hideAlert() {
      document.getElementById('alert').style.display = 'none';
    }

    async function loginRestaurant(e) {
      e.preventDefault();
      hideAlert();
      try {
        const res = await fetch('/api/auth/restaurant/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            phone: document.getElementById('r-phone').value,
            password: document.getElementById('r-password').value
          })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          showAlert(data.error);
        }
      } catch (err) {
        showAlert('Connection error. Try again.');
      }
    }

    async function loginAdmin(e) {
      e.preventDefault();
      hideAlert();
      try {
        const res = await fetch('/api/auth/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: document.getElementById('a-username').value,
            password: document.getElementById('a-password').value
          })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          showAlert(data.error);
        }
      } catch (err) {
        showAlert('Connection error. Try again.');
      }
    }
  </script>
</body>
</html>
