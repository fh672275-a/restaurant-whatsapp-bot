<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - WhatsApp Restaurant Bot</title>
  <meta name="theme-color" content="#075E54">
  <meta name="description" content="AI-Powered Restaurant Management System with WhatsApp Bot">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
  <link rel="icon" type="image/png" href="/icons/icon-192x192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Restaurant Bot">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', -apple-system, sans-serif;
      padding: 20px;
    }
    .login-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      max-width: 420px;
      width: 100%;
      padding: 40px;
    }
    .logo {
      text-align: center;
      margin-bottom: 30px;
    }
    .logo-icon {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 32px;
      margin-bottom: 12px;
    }
    .logo h1 {
      font-size: 22px;
      color: #075E54;
      margin: 0;
      font-weight: 700;
    }
    .logo p {
      color: #888;
      font-size: 13px;
      margin: 4px 0 0;
    }
    .form-tabs {
      display: flex;
      background: #f0f2f5;
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 24px;
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      text-align: center;
      border: none;
      background: transparent;
      color: #666;
      font-weight: 600;
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.2s;
      font-size: 14px;
    }
    .tab-btn.active {
      background: white;
      color: #075E54;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #555;
      margin-bottom: 6px;
    }
    .form-control {
      width: 100%;
      padding: 12px 14px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 14px;
      transition: all 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: #25D366;
      box-shadow: 0 0 0 3px rgba(37,211,102,0.1);
    }
    .btn-login {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.1s;
    }
    .btn-login:active { transform: scale(0.98); }
    .btn-login:disabled { opacity: 0.6; cursor: not-allowed; }
    .alert {
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
    }
    .alert-danger {
      background: #ffeef0;
      color: #c81e2c;
      border: 1px solid #ffcdd2;
    }
    .alert-success {
      background: #e8f5e9;
      color: #2e7d32;
      border: 1px solid #a5d6a7;
    }
    .signup-link {
      text-align: center;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #e0e0e0;
      font-size: 13px;
      color: #666;
    }
    .signup-link a {
      color: #25D366;
      font-weight: 600;
      text-decoration: none;
    }
    .forgot-link {
      text-align: right;
      margin-top: -10px;
      margin-bottom: 16px;
    }
    .forgot-link a {
      font-size: 12px;
      color: #666;
      text-decoration: none;
    }
    .forgot-link a:hover { color: #25D366; }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="logo">
      <div class="logo-icon"><i class="fab fa-whatsapp"></i></div>
      <h1>Restaurant Bot</h1>
      <p>Order Management System</p>
    </div>

    <div class="form-tabs">
      <button class="tab-btn active" onclick="switchTab('restaurant', this)">
        <i class="fas fa-store"></i> Restaurant
      </button>
      <button class="tab-btn" onclick="switchTab('admin', this)">
        <i class="fas fa-user-shield"></i> Admin
      </button>
    </div>

    <div id="alert" class="alert alert-danger"></div>

    <!-- Restaurant Login -->
    <form id="restaurant-form" onsubmit="loginRestaurant(event)">
      <div class="form-group">
        <label>Phone Number</label>
        <input type="tel" class="form-control" id="r-phone" placeholder="03001234567" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" id="r-password" placeholder="••••••••" required>
      </div>
      <div class="forgot-link">
        <a href="#" onclick="showForgotPassword(); return false;">Password bhool gaye?</a>
      </div>
      <button type="submit" class="btn-login" id="r-btn">
        <i class="fas fa-sign-in-alt"></i> Login Karein
      </button>
    </form>

    <!-- Admin Login -->
    <form id="admin-form" style="display: none;" onsubmit="loginAdmin(event)">
      <div class="form-group">
        <label>Username</label>
        <input type="text" class="form-control" id="a-username" placeholder="admin" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" id="a-password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn-login" id="a-btn">
        <i class="fas fa-sign-in-alt"></i> Admin Login
      </button>
    </form>

    <!-- Forgot Password -->
    <form id="forgot-form" style="display: none;" onsubmit="sendForgotOTP(event)">
      <h6><i class="fas fa-key"></i> Password Reset</h6>
      <div class="form-group">
        <label>Phone Number</label>
        <input type="tel" class="form-control" id="f-phone" placeholder="03001234567" required>
      </div>
      <button type="submit" class="btn-login" id="f-btn">
        <i class="fas fa-paper-plane"></i> OTP Bhejein
      </button>
      <div id="otp-section" class="hidden mt-3">
        <div class="form-group">
          <label>OTP</label>
          <input type="text" class="form-control text-center" id="f-otp" placeholder="000000" maxlength="6" style="font-size: 20px; letter-spacing: 6px;">
        </div>
        <div class="form-group">
          <label>New Password</label>
          <input type="password" class="form-control" id="f-new-password" placeholder="New password">
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" class="form-control" id="f-confirm-password" placeholder="Confirm password">
        </div>
        <button type="button" class="btn-login" onclick="resetPassword()">
          <i class="fas fa-check"></i> Reset Password
        </button>
      </div>
      <div class="text-center mt-3">
        <a href="#" onclick="backToLogin(); return false;" style="font-size: 12px; color: #666;">
          <i class="fas fa-arrow-left"></i> Back to Login
        </a>
      </div>
    </form>

    <div class="signup-link">
      Naya restaurant? <a href="/signup">Free Sign Up Karein</a>
    </div>
    
    <!-- PWA Install Button -->
    <div id="pwa-install-container" style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e0e0e0; text-align: center;">
      <button onclick="installPWA()" class="btn btn-outline-success" style="width: 100%; padding: 10px; font-size: 14px;">
        <i class="fas fa-download"></i> Desktop App Install Karein
      </button>
      <p style="font-size: 11px; color: #999; margin-top: 8px;">
        App desktop par install ho jayega - browser ki zaroorat nahi
      </p>
    </div>
  </div>

  <script>
    // PWA Installation
    let deferredPrompt = null;
    
    // Register service worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then((reg) => {
            console.log('[PWA] Service Worker registered:', reg.scope);
          })
          .catch((err) => {
            console.log('[PWA] SW registration failed:', err);
          });
      });
    }
    
    // Listen for install prompt
    window.addEventListener('beforeinstallprompt', (e) => {
      console.log('[PWA] Install prompt available');
      e.preventDefault();
      deferredPrompt = e;
      document.getElementById('pwa-install-container').style.display = 'block';
    });
    
    // Install PWA
    async function installPWA() {
      if (!deferredPrompt) {
        alert('Install option browser mein nahi dikh raha. Chrome ya Edge use karein.');
        return;
      }
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        console.log('[PWA] User accepted install');
        document.getElementById('pwa-install-container').style.display = 'none';
      }
      deferredPrompt = null;
    }
    
    // Detect if already installed
    window.addEventListener('appinstalled', (e) => {
      console.log('[PWA] App installed successfully!');
      document.getElementById('pwa-install-container').style.display = 'none';
    });
    
    // Check if running as PWA
    if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
      document.getElementById('pwa-install-container').style.display = 'none';
    }
    
    function switchTab(tab, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('restaurant-form').style.display = tab === 'restaurant' ? 'block' : 'none';
      document.getElementById('admin-form').style.display = tab === 'admin' ? 'block' : 'none';
      document.getElementById('forgot-form').style.display = 'none';
      hideAlert();
    }

    function showAlert(msg, type = 'danger') {
      const alert = document.getElementById('alert');
      alert.className = `alert alert-${type}`;
      alert.textContent = msg;
      alert.style.display = 'block';
    }

    function hideAlert() {
      document.getElementById('alert').style.display = 'none';
    }

    function showForgotPassword() {
      document.getElementById('restaurant-form').style.display = 'none';
      document.getElementById('admin-form').style.display = 'none';
      document.getElementById('forgot-form').style.display = 'block';
      hideAlert();
    }

    function backToLogin() {
      document.getElementById('forgot-form').style.display = 'none';
      document.getElementById('restaurant-form').style.display = 'block';
      document.getElementById('otp-section').classList.add('hidden');
      hideAlert();
    }

    async function loginRestaurant(e) {
      e.preventDefault();
      hideAlert();
      const btn = document.getElementById('r-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Login ho raha hai...';
      
      try {
        const res = await fetch('/api/auth/restaurant/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            phone: document.getElementById('r-phone').value,
            password: document.getElementById('r-password').value
          })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Login Karein';
        }
      } catch (err) {
        showAlert('Server se connect nahi ho saka. 3 second baad automatically retry hoga...');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Login Karein';
        // Auto retry after 3 seconds
        setTimeout(() => {
          if (document.getElementById('r-phone').value && document.getElementById('r-password').value) {
            loginRestaurant({ preventDefault: () => {} });
          }
        }, 3000);
      }
    }

    async function loginAdmin(e) {
      e.preventDefault();
      hideAlert();
      const btn = document.getElementById('a-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Login ho raha hai...';
      
      try {
        const res = await fetch('/api/auth/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: document.getElementById('a-username').value,
            password: document.getElementById('a-password').value
          })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Admin Login';
        }
      } catch (err) {
        showAlert('Server se connect nahi ho saka. 3 second baad retry hoga...');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Admin Login';
        setTimeout(() => {
          if (document.getElementById('a-username').value && document.getElementById('a-password').value) {
            loginAdmin({ preventDefault: () => {} });
          }
        }, 3000);
      }
    }

    async function sendForgotOTP(e) {
      e.preventDefault();
      hideAlert();
      const btn = document.getElementById('f-btn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Bhej raha hai...';
      
      try {
        const phone = document.getElementById('f-phone').value;
        const res = await fetch('/api/auth/restaurant/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone })
        });
        const data = await res.json();
        if (data.success) {
          showAlert(data.message, 'success');
          if (!data.sentViaWhatsApp && data.otp) {
            showAlert(`OTP: ${data.otp} (Demo mode - WhatsApp connect hone par auto bheja jayega)`, 'success');
          }
          document.getElementById('otp-section').classList.remove('hidden');
          btn.innerHTML = '<i class="fas fa-check"></i> OTP Bhej Diya';
        } else {
          showAlert(data.error);
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-paper-plane"></i> OTP Bhejein';
        }
      } catch (err) {
        showAlert('Connection error');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> OTP Bhejein';
      }
    }

    async function resetPassword() {
      hideAlert();
      const phone = document.getElementById('f-phone').value;
      const otp = document.getElementById('f-otp').value;
      const newPassword = document.getElementById('f-new-password').value;
      const confirmPassword = document.getElementById('f-confirm-password').value;
      
      if (!otp || otp.length !== 6) return showAlert('6-digit OTP likhein');
      if (!newPassword || newPassword.length < 6) return showAlert('Password kam az kam 6 characters ka ho');
      if (newPassword !== confirmPassword) return showAlert('Passwords match nahi karte');
      
      try {
        const res = await fetch('/api/auth/restaurant/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, otp, new_password: newPassword, confirm_password: confirmPassword })
        });
        const data = await res.json();
        if (data.success) {
          alert('Password change ho gaya! Ab login karein.');
          window.location.href = '/login';
        } else {
          showAlert(data.error);
        }
      } catch (err) {
        showAlert('Connection error');
      }
    }
  </script>
</body>
</html>
