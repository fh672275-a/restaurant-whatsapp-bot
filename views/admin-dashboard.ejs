<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Restaurant WhatsApp Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">
          <i class="fab fa-whatsapp"></i>
        </div>
        <div>
          <h2>Bot Admin</h2>
          <p>Super Admin Panel</p>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="active">
          <i class="fas fa-tachometer-alt"></i> Dashboard
        </a>
        <a href="/admin/restaurants">
          <i class="fas fa-store"></i> Restaurants
        </a>
        <a href="/admin/restaurants/new">
          <i class="fas fa-plus-circle"></i> Add Restaurant
        </a>
        <a href="/api/whatsapp/sessions/all" target="_blank">
          <i class="fas fa-link"></i> All Sessions
        </a>
        <a href="/logout">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <header class="top-bar">
        <h1>Dashboard</h1>
        <div class="user-info">
          <i class="fas fa-user-shield"></i> Super Admin
        </div>
      </header>

      <div class="content-body">
        <!-- Stats Cards -->
        <div class="stats-grid">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="fas fa-store"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-restaurants">-</div>
              <div class="stat-label">Total Restaurants</div>
            </div>
          </div>
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fab fa-whatsapp"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="connected-whatsapp">-</div>
              <div class="stat-label">WhatsApp Connected</div>
            </div>
          </div>
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-orders">-</div>
              <div class="stat-label">Total Orders</div>
            </div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-money-bill-wave"></i></div>
            <div class="stat-data">
              <div class="stat-value" id="total-revenue">-</div>
              <div class="stat-label">Total Revenue</div>
            </div>
          </div>
        </div>

        <!-- Recent Restaurants -->
        <div class="card mt-4">
          <div class="card-header">
            <h3>Recent Restaurants</h3>
            <a href="/admin/restaurants" class="btn btn-sm btn-primary">View All</a>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>WhatsApp</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="recent-restaurants">
                  <tr><td colspan="6" class="text-center">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadDashboard() {
      try {
        const res = await fetch('/api/restaurants?page=1');
        const data = await res.json();
        const restaurants = data.restaurants || [];
        
        document.getElementById('total-restaurants').textContent = data.pagination?.total || 0;
        const connected = restaurants.filter(r => r.whatsapp_connected).length;
        document.getElementById('connected-whatsapp').textContent = connected;

        // Get all stats by fetching each restaurant
        let totalOrders = 0;
        let totalRevenue = 0;
        for (const r of restaurants.slice(0, 10)) {
          try {
            const detail = await fetch(`/api/restaurants/${r.id}`).then(r => r.json());
            totalOrders += detail.stats?.total_orders || 0;
            totalRevenue += detail.stats?.total_revenue || 0;
          } catch (e) {}
        }
        document.getElementById('total-orders').textContent = totalOrders;
        document.getElementById('total-revenue').textContent = 'Rs. ' + totalRevenue.toLocaleString();

        // Render restaurants table
        const tbody = document.getElementById('recent-restaurants');
        if (restaurants.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center">Koi restaurant nahi hai. <a href="/admin/restaurants/new">Pehla add karein</a></td></tr>';
          return;
        }
        tbody.innerHTML = restaurants.slice(0, 10).map(r => `
          <tr>
            <td><strong>${r.name}</strong></td>
            <td>${r.phone}</td>
            <td>
              ${r.whatsapp_connected 
                ? `<span class="badge bg-success"><i class="fab fa-whatsapp"></i> ${r.whatsapp_phone || 'Connected'}</span>` 
                : '<span class="badge bg-secondary">Not Connected</span>'}
            </td>
            <td>
              ${r.is_active 
                ? '<span class="badge bg-success">Active</span>' 
                : '<span class="badge bg-danger">Inactive</span>'}
            </td>
            <td>${new Date(r.created_at).toLocaleDateString()}</td>
            <td>
              <a href="/admin/restaurants/${r.id}" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-eye"></i>
              </a>
            </td>
          </tr>
        `).join('');
      } catch (e) {
        console.error(e);
      }
    }

    loadDashboard();
  </script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
